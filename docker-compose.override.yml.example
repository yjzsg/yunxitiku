# 本机部署覆盖（示例）——复制成 docker-compose.override.yml 后填真实值。
#
# 为什么单独放这个文件：docker-compose.override.yml 已在 .gitignore 里，
# 上游题库服务的账号属于机密，**不进仓库**。
#
# 用法：
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   然后按需修改（image 指向本地构建、卷指向实际数据目录、填账号）
#
# 不填账号会怎样：拉取/「检查可更新」会返回明确错误
#   「缺少上游题库服务账号/密码。…」（不会静默失败，也不会拿空账号去请求）。
services:
  yunxi-tiku:
    # 用本地构建的镜像（不用 ghcr 上的公开镜像）
    image: yunxi-tiku:local
    volumes:
      # 主库 / 拉取库 / 题图（assets 与 assets-pulled 都在这个目录下）
      - /path/to/data:/app/data
      # 账号数据（accounts.dat、各用户 json）
      - /path/to/userdata:/app/userdata
    environment:
      # 上游题库服务账号。也可以只写这两行到 .env 再由 compose 展开。
      App__BankServiceUser: "你的账号"
      App__BankServicePassword: "你的口令"
      # 服务地址一般不用改（代码里已有金考典官方地址作默认值）
      # App__BankServiceUrl: "http://app1.jinkaodian.com/CL.ExamWebService/ExamClientService.asmx"
