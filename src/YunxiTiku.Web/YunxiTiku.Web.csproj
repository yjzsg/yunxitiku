<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-platform question-bank puller, so the Docker admin page can pull courses
         straight from the upstream service instead of only accepting an uploaded zip.
         Kept byte-identical to webapp-core/JkdWeb.BankPuller by scripts/verify-puller-sync.ps1. -->
    <ProjectReference Include="..\JkdWeb.BankPuller\JkdWeb.BankPuller.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="public\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
